---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type PostData = CollectionEntry<'blog'>['data'];
// category and lang are optional here because the About page also uses this layout.
type Props = Omit<PostData, 'category' | 'lang'> & {
	category?: PostData['category'];
	lang?: PostData['lang'];
};

const { title, description, pubDate, updatedDate, heroImage, category, lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.post-header {
				margin-bottom: 2.5rem;
			}
			.hero-image {
				display: block;
				width: 100%;
				margin-bottom: 2rem;
				box-shadow: var(--elevation-1);
			}
			.meta-row {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem 0.75rem;
				margin-bottom: 0.75rem;
			}
			h1 {
				margin-bottom: 0.5rem;
			}
			.description {
				margin: 0;
				font-size: 1.1rem;
				color: var(--on-surface-variant);
			}
			.updated {
				font-style: italic;
			}
			/* Headings inside the post text */
			.prose :global(h2) {
				margin-top: 2.25rem;
				font-size: 1.45rem;
			}
			.prose :global(h3) {
				margin-top: 1.75rem;
				font-size: 1.2rem;
			}
			.prose :global(li) {
				margin-bottom: 0.35em;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && <Image class="hero-image" width={1020} height={510} src={heroImage} alt="" />}
				<header class="post-header">
					<div class="meta-row">
						{category && <a class="chip" href={`/category/${category}/`}>{category}</a>}
						<span class="meta">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<span class="updated">
									{' '}
									· updated <FormattedDate date={updatedDate} />
								</span>
							)}
						</span>
					</div>
					<h1>{title}</h1>
					<p class="description">{description}</p>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
