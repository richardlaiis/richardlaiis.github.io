---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Yu-Chi Lai. All rights reserved.
	<div class="social-links">
		<a href="https://x.com/nyan0xuwu" target="_blank" rel="noopener">
			<span class="sr-only">Follow Yu-Chi Lai on X</span>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28">
				<path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path>
			</svg>
		</a>
		<a href="https://github.com/richardlaiis" target="_blank" rel="noopener">
			<span class="sr-only">Yu-Chi Lai on GitHub</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32" astro-icon="social/github">
				<path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path>
			</svg>
		</a>
	</div>
</footer>
<style>
	footer {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 2rem 1.25rem 3rem;
		font-size: 0.9rem;
		color: var(--on-surface-variant);
		text-align: center;
		border-top: 1px solid var(--outline-variant);
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 0.25rem;
		margin-top: 0.75rem;
	}
	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		color: var(--on-surface-variant);
		border-radius: var(--radius-full);
		transition: background-color 0.2s;
	}
	.social-links a:hover {
		color: var(--on-surface);
		background: var(--surface-container-high);
	}
	.social-links svg {
		width: 22px;
		height: 22px;
	}
</style>
