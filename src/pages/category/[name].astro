---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, SITE_TITLE } from '../../consts';

// Astro builds one page per category: /category/life/, /category/knowledge/, ...
export function getStaticPaths() {
	return CATEGORIES.map((name) => ({ params: { name } }));
}

const { name } = Astro.params;
const label = name.charAt(0).toUpperCase() + name.slice(1);

// Only the posts in this category, newest first.
const posts = (await getCollection('blog', (post) => post.data.category === name)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${label} · ${SITE_TITLE}`} description={`Posts in the ${label} category.`} />
		<style>
			.page-header {
				margin-bottom: 2rem;
			}
			.back {
				font-size: 0.9rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<a class="back" href="/blog/">← All posts</a>
				<h1>{label}</h1>
				<p class="meta">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
			</div>
			{posts.length === 0 ? <p>No posts yet.</p> : posts.map((post) => <PostCard post={post} />)}
		</main>
		<Footer />
	</body>
</html>
