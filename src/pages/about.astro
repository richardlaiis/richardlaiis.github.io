---
import { getEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

// All CV content comes from src/data/cv.yaml (loaded in src/content.config.ts).
const entry = await getEntry('cv', 'cv');
if (!entry) throw new Error('CV data not found: check src/data/cv.yaml');
const cv = entry.data;

// "Sep 2023 – Present", or just "Sep 2023" if there's no end date.
const range = (start: string, end?: string) => (end ? `${start} – ${end}` : start);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About · ${SITE_TITLE}`} description={cv.summary} />
		<style>
			.cv-header {
				margin-bottom: 2em;
			}
			.cv-header h1 {
				margin-bottom: 0.2em;
			}
			.headline {
				margin: 0;
				color: rgb(var(--gray));
			}
			.contact {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em 1.5em;
				margin: 0.5em 0 0;
				padding: 0;
				list-style: none;
			}
			section {
				margin-bottom: 2em;
			}
			h2 {
				padding-bottom: 0.2em;
				border-bottom: 1px solid rgb(var(--gray-light));
				font-size: 1.5em;
			}
			.item {
				margin-bottom: 1.2em;
			}
			.item-top {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-between;
				gap: 0 1em;
			}
			.item h3 {
				margin: 0;
				font-size: 1.1em;
			}
			.when {
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.sub {
				margin: 0;
				color: rgb(var(--gray));
			}
			.item ul {
				margin: 0.3em 0 0;
			}
			.item p {
				margin: 0.2em 0 0;
			}
			.skills {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.download {
				display: inline-block;
				margin-top: 1em;
				padding: 0.4em 1em;
				border: 2px solid var(--accent);
				border-radius: 8px;
				text-decoration: none;
			}
			.download:hover {
				background: var(--accent);
				color: white;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="cv-header">
				<h1>{cv.name}</h1>
				{cv.headline && <p class="headline">{cv.headline}</p>}
				{cv.contact.length > 0 && (
					<ul class="contact">
						{cv.contact.map((c) => (
							<li>
								<a href={c.url}>{c.label}</a>
							</li>
						))}
					</ul>
				)}
				<a class="download" href="/cv.pdf" target="_blank" rel="noopener">
					View CV (PDF)
				</a>
			</div>

			<section>
				<h2>Summary</h2>
				<p>{cv.summary}</p>
			</section>

			{cv.education.length > 0 && (
				<section>
					<h2>Education</h2>
					{cv.education.map((e) => (
						<div class="item">
							<div class="item-top">
								<h3>{e.school}</h3>
								<span class="when">{range(e.start, e.end)}</span>
							</div>
							<p class="sub">
								{e.degree}
								{e.location && ` · ${e.location}`}
							</p>
							{e.details.length > 0 && (
								<ul>
									{e.details.map((d) => (
										<li>{d}</li>
									))}
								</ul>
							)}
						</div>
					))}
				</section>
			)}

			{cv.experience.length > 0 && (
				<section>
					<h2>Experience</h2>
					{cv.experience.map((x) => (
						<div class="item">
							<div class="item-top">
								<h3>{x.title}</h3>
								<span class="when">{range(x.start, x.end)}</span>
							</div>
							<p class="sub">
								{x.org}
								{x.location && ` · ${x.location}`}
							</p>
							{x.details.length > 0 && (
								<ul>
									{x.details.map((d) => (
										<li>{d}</li>
									))}
								</ul>
							)}
						</div>
					))}
				</section>
			)}

			{cv.projects.length > 0 && (
				<section>
					<h2>Projects</h2>
					{cv.projects.map((p) => (
						<div class="item">
							<h3>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h3>
							<p>{p.description}</p>
						</div>
					))}
				</section>
			)}

			{cv.skills.length > 0 && (
				<section>
					<h2>Skills</h2>
					<ul class="skills">
						{cv.skills.map((s) => (
							<li>
								<strong>{s.group}:</strong> {s.items.join(', ')}
							</li>
						))}
					</ul>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
